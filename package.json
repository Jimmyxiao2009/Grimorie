{
  "name": "grimoire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first writing environment built around the metaphor of a physical manuscript.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^26.2.0",
    "jsdom": "^28.0.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-character-count": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2"
  },
  "packageManager": "pnpm@11.9.0"
}
